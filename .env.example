# Strava API credentials — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# GeoJSON FeatureCollections with one Polygon each; coordinates are [longitude, latitude].
STRAVA_COMMUTE_START_GEOFENCE=
STRAVA_COMMUTE_END_GEOFENCE=

# Optional exact Strava gear ID; if unset, a unique name match is used.
STRAVA_COMMUTER_GEAR_ID=
STRAVA_COMMUTER_GEAR_NAME=Ridley

# Webhook verification token — any random string you choose
STRAVA_VERIFY_TOKEN=

# Supabase Postgres — Project Settings > Database > Connection string >
# Transaction pooler (port 6543). Required for serverless/Vercel deployments.
DATABASE_URL=

# Google Gemini API key — https://aistudio.google.com/app/apikey
# Used for auto-generating activity descriptions. Optional.
GEMINI_API_KEY=

# Link appended to AI-generated activity descriptions. Optional.
APP_URL=https://your-dashboard.vercel.app

# Database connection URL — PostgreSQL connection string
DATABASE_URL=postgresql://username:password@host:port/database
